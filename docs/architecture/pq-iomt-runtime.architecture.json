  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime path",
      "items": [
        "The device signs padded telemetry and attaches a SHA3-256 HMAC.",
        "QSES checks client identity, timestamp, sequence, and device signature before forwarding.",
        "The medical server verifies the edge signature, decrypts the client packet, and rechecks end-to-end integrity."
      ]
    },
    {
      "dot": "violet",
      "title": "Cryptographic roles",
      "items": [
        "ML-DSA-44 signs device and QSES content; ML-KEM-512 establishes the per-packet shared secret.",
        "HKDF-SHA256 derives the AES-256-GCM key from the ML-KEM secret and a fresh salt."
      ]
    },
    {
      "dot": "amber",
      "title": "Implementation boundary",
      "items": [
        "The repository models nodes and packets in-process; it contains no HTTP endpoint, message broker, or network transport implementation.",
        "Client records, replay state, anomaly logs, retransmission requests, and accepted readings are process-local Python collections."
      ]
    }
  ]
