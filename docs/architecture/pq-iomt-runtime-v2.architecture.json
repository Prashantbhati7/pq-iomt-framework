  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime path",
      "items": [
        "The device pads telemetry to 100 bytes, emits metadata, signs SHA3-256(M || metadata), and attaches an HMAC.",
        "QSES authenticates the device and freshness before wrapping the complete client packet for the medical server.",
        "The server validates transport and end-to-end integrity before committing an accepted reading."
      ]
    },
    {
      "dot": "violet",
      "title": "Trust and protection",
      "items": [
        "ML-DSA-44 signs device and edge content; ML-KEM-512 plus HKDF-SHA256 derives the AES-256-GCM packet key.",
        "The HMAC key is shared only by the device and medical server, allowing the server to flag a compromised QSES."
      ]
    },
    {
      "dot": "amber",
      "title": "Demo and evaluation",
      "items": [
        "The notebook demonstrates a successful reading, replay rejection, transport-signature rejection, and malicious-edge HMAC detection.",
        "The benchmark measures the same in-process pipeline and writes timing, resource, and packet-size results to benchmarks/results.json."
      ]
    }
  ]
